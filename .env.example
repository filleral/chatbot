# Variables de entorno del bot.
#
#  - En Render:  Dashboard → tu servicio → Environment → Add Environment Variable
#  - En local:   copia este archivo a  .env  (está en .gitignore) y expórtalas,
#                o usa  dotnet user-secrets, o un appsettings.Development.json
#
# El doble guion bajo __ representa el anidamiento (WhatsApp__VerifyToken -> WhatsApp:VerifyToken).

WhatsApp__VerifyToken=inventate-una-cadena-secreta-cualquiera
WhatsApp__AccessToken=EAA...tu-token-permanente-de-meta
WhatsApp__PhoneNumberId=526644653870463
WhatsApp__AdvisorPhoneNumber=573219114191,573507633867

PropertyScraper__ListingUrl=https://bienesraiceswhite.co/inmuebles/
PropertyScraper__MaxPages=3
PropertyScraper__CacheMinutes=10

PostgresConnectionString=Host=ep-xxxx-pooler.c-5.us-east-2.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=TU_PASSWORD;SSL Mode=Require;Trust Server Certificate=true

