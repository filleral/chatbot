# Variables de entorno del bot.
#
#  - En Render:  Dashboard → tu servicio → Environment → Add Environment Variable
#  - En local:   copia este archivo a  .env  (está en .gitignore) y expórtalas,
#                o usa  dotnet user-secrets, o un appsettings.Development.json
#
# El doble guion bajo __ representa el anidamiento (WhatsApp__VerifyToken -> WhatsApp:VerifyToken).

WhatsApp__VerifyToken=inventate-una-cadena-secreta-cualquiera
WhatsApp__AccessToken=EAA...tu-token-permanente-de-meta
WhatsApp__PhoneNumberId=526644653870463
WhatsApp__AdvisorPhoneNumber=573219114191,573507633867

PropertyScraper__ListingUrl=https://bienesraiceswhite.co/inmuebles/
PropertyScraper__MaxPages=3
PropertyScraper__CacheMinutes=10

PostgresConnectionString=Host=ep-xxxx-pooler.c-5.us-east-2.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=TU_PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# --- Publicar inmuebles de WordPress en Facebook + Instagram (opcional) ---
Social__WebhookSecret=inventa-un-secreto-y-ponlo-igual-en-wordpress
Social__MetaAccessToken=EAA...token-con-permisos-de-paginas-e-instagram
Social__FacebookPageId=417059049062092
Social__InstagramUserId=17841411886661916
Social__WpBaseUrl=https://bienesraiceswhite.co
Social__PostType=em_portfolio
Social__MaxImagenes=10

# --- Panel de control (login de /panel) ---
Dashboard__Email=gerencia@bienesraiceswhite.co
Dashboard__Password=cambia-esta-contrasena

# --- Aviso de leads por correo (recomendado: el WhatsApp al asesor solo llega si ese
#     número escribió al bot en las últimas 24 h). Se usa una API HTTPS porque Render
#     bloquea el SMTP. La clave define el proveedor:
#       re_...       -> Resend  (resend.com, 3000/mes gratis, sin verificar dominio si
#                                envías a tu propio correo desde onboarding@resend.dev)
#       xkeysib-...  -> Brevo   (brevo.com, 300/día gratis, verificas el remitente por email)
Email__ApiKey=re_xxxxxxxxxxxxxxxxxxxx
Email__To=gerencia@bienesraiceswhite.co
Email__From=                       # opcional en Resend; en Brevo = remitente verificado
Email__FromName=Bienes Raíces White
