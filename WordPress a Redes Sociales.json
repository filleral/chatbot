    {
      "parameters": {
        "jsCode": "var input = items[0].json;\nvar body = input.body || input;\nvar post = body.post || body;\nvar postId = post.ID || post.id || body.post_id || input.post_id || '';\nvar postStatus = post.post_status || body.post_status || '';\nvar titulo = post.post_title || body.post_title || '';\nvar skip = false;\n\nif (postStatus !== 'publish') { skip = true; }\nif (!titulo || titulo === 'Auto Draft' || titulo === 'Borrador automatico' || titulo === 'Borrador automático') { skip = true; }\n\nvar contenido = '';\nvar url = '';\nvar imagen = '';\nvar fecha = '';\n\nif (!skip) {\n  contenido = (post.post_content || post.post_excerpt || body.post_content || '').replace(/<[^>]+>/g, '').replace(/\\[.*?\\]/g, '').trim().substring(0, 300);\n  url = post.guid || post.permalink || body.permalink || '';\n  imagen = post.featured_image_url || post.featured_image || body.featured_image_url || '';\n  fecha = new Date().toLocaleDateString('es-CO', {timeZone: 'America/Bogota'});\n}\n\nreturn [{json: {skip: skip, titulo: titulo, contenido: contenido, url: url, imagen: imagen, fecha: fecha, postStatus: postStatus, postId: postId}}];"
      },
